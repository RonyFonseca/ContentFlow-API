generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts         Post[]
  categories    Category[]
  ideas         Idea[]
  notifications Notification[]
}

model Category {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  posts Post[]
  ideas Idea[]

  @@unique([userId, name])
}

model Idea {
  id          String    @id @default(uuid())
  title       String
  content     String
  plannedDate DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  post          Post?
  notifications Notification[]
  Image         Image[]

  @@index([userId])
}

model Post {
  id        String   @id @default(uuid())
  title     String
  content   String
  status    String
  type      String
  date      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  images Image[]

  ideaId String? @unique
  idea   Idea?   @relation(fields: [ideaId], references: [id], onDelete: SetNull)

  notifications Notification[]
}

model Image {
  id        String   @id @default(uuid())
  path      String
  mimeType  String
  size      Int
  createdAt DateTime @default(now())

  postId String?
  post   Post?   @relation(fields: [postId], references: [id], onDelete: Cascade)

  ideaId String?
  idea   Idea?   @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([ideaId])
}

model Notification {
  id           String    @id @default(uuid())
  title        String
  message      String
  type         String
  read         Boolean   @default(false)
  createdAt    DateTime  @default(now())
  scheduledFor DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  postId String?
  post   Post?   @relation(fields: [postId], references: [id], onDelete: Cascade)

  ideaId String?
  idea   Idea?   @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([postId])
  @@index([ideaId])
}
